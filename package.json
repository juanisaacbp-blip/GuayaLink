{
  "name": "guayalink-ui",
  "version": "1.0.1",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "start": "ng serve",
    "build": "ng build",
    "electron": "electron .",
    "electron:dev": "concurrently \"ng serve\" \"wait-on http://localhost:4200 && electron .\"",
    "electron:build": "ng build --base-href ./ && electron-builder",
    "electron:build:linux": "ng build --base-href ./ && electron-builder --linux AppImage --publish never",
    "electron:build:mac": "ng build --base-href ./ && electron-builder --mac dmg --publish never"
  },
  "dependencies": {
    "@angular/common": "20.3.31",
    "@angular/compiler": "20.3.31",
    "@angular/core": "20.3.31",
    "@angular/forms": "20.3.31",
    "@angular/platform-browser": "20.3.31",
    "@angular/router": "20.3.31",
    "@angular/service-worker": "20.3.31",
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "firebase": "^12.19.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "leaflet": "^1.9.4",
    "leaflet.heat": "^0.2.0",
    "qrcode": "^1.5.4",
    "rxjs": "^7.8.1",
    "tslib": "^2.8.1",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "20.3.37",
    "@angular/cli": "20.3.37",
    "@angular/compiler-cli": "20.3.31",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.heat": "^0.2.5",
    "@types/qrcode": "^1.5.6",
    "concurrently": "^9.2.1",
    "electron": "^44.5.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.8.0",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.guayalink.app",
    "productName": "GuayaLink",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "GuayaLink-Windows-v${version}-Setup.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Utility",
      "artifactName": "GuayaLink-Linux-v${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.utilities",
      "artifactName": "GuayaLink-macOS-v${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
